# Absolute or root-relative path. Default: src/mastra/public/.data/mastra.db
# SHIFTS_DATABASE_PATH=src/mastra/public/.data/mastra.db
MASTRA_URL=http://127.0.0.1:4111
OPENWA_URL=http://127.0.0.1:2785
# Generate a random secret and use the same value in the OpenWA webhook settings.
OPENWA_WEBHOOK_SECRET=
# Optional: read from apps/openwa/data/.api-key when unset.
OPENWA_API_KEY=
SHIFTS_TIMEZONE=America/Argentina/Buenos_Aires
# Set the exact public HTTPS origin when using a reverse proxy.
# APP_ORIGIN=https://your-domain.example

# Supabase Auth: server-only. Use a publishable key, never a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ADMIN_USER_ID=
SUPABASE_ADMIN_EMAIL=
ADMIN_USERNAME=messi
