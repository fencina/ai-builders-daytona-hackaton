{
  "name": "ai-builders-daytona-hackaton",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "daytona:deploy": "node --experimental-strip-types scripts/daytona.ts deploy",
    "daytona:resume": "node --experimental-strip-types scripts/daytona.ts resume",
    "daytona:start": "node --experimental-strip-types scripts/daytona.ts start",
    "daytona:stop": "node --experimental-strip-types scripts/daytona.ts stop",
    "daytona:status": "node --experimental-strip-types scripts/daytona.ts status",
    "daytona:urls": "node --experimental-strip-types scripts/daytona.ts urls",
    "test:daytona": "node --experimental-strip-types --test scripts/daytona-files.test.ts",
    "dev": "mastra dev",
    "dev:web": "npm --prefix apps/web run dev",
    "install:web": "npm --prefix apps/web install",
    "build:web": "npm --prefix apps/web run build",
    "test:turnos": "node --experimental-strip-types --test packages/db/domain.test.ts",
    "test:web": "npm run build:web && node --experimental-strip-types apps/web/scripts/integration.mjs",
    "dev:openwa": "npm --prefix apps/openwa run dev",
    "install:openwa": "npm --prefix apps/openwa install",
    "build": "mastra build",
    "start": "mastra start"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@daytona/sdk": "^0.231.1",
    "@mastra/core": "1.83.0",
    "@mastra/duckdb": "1.19.0",
    "@mastra/libsql": "1.30.0",
    "@mastra/memory": "1.41.1",
    "@mastra/observability": "1.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.39.0",
    "typescript": "^6.0.3"
  }
}
